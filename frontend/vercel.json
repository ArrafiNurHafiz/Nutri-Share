{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nutrishare-api.vercel.app/api/$1"
    },
    {
      "source": "/health",
      "destination": "https://nutrishare-api.vercel.app/health"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://nutrishare-api.vercel.app/uploads/$1"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
