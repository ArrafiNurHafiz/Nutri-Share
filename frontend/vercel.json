{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nutrishare-api.vercel.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://nutrishare-api.vercel.app/health"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://nutrishare-api.vercel.app/uploads/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
