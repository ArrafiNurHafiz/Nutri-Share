# NutriShare Environment Variables

# App Configuration
ENVIRONMENT=production
PORT=3000
LOG_LEVEL=info

# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
ADMIN_SECRET_KEY=your-super-secret-admin-key-min-32-chars
COOKIE_NAME=nutrishare_token
COOKIE_DOMAIN=

# Frontend URL (for CORS, single-origin convenience)
FRONTEND_URL=https://yourdomain.com

# Database - Supabase PostgreSQL (required)
DATABASE_URL=postgresql+asyncpg://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# CORS
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
